# PostgreSQL, pooled production connection with TLS; no secret values in this file.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAIL=
# One-time admin:create only, remove after provisioning.
ADMIN_PASSWORD=
CRON_SECRET=
ADS_INGEST_SECRET=
# Porkbun: STARTTLS on port 587 (or alternative 50587); port 465 uses implicit TLS.
# Full corporate mailbox as username. No automatic port failover.
SMTP_HOST=smtp.porkbun.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional corporate identity/footer, required to enable external outreach.
OUTREACH_FOOTER=
# Reference only: incoming mailbox sync is not implemented.
# IMAP imap.porkbun.com:993 SSL/TLS; POP pop.porkbun.com:995 SSL/TLS.
# Optional public web search via Brave Search API, research only.
BRAVE_SEARCH_API_KEY=
# Daily internal budget alert thresholds, per currency, e.g. {"USD":50,"EUR":40}
DAILY_BUDGETS={}
# Compared with previous 7 days, default multiplier 2
SPEND_ANOMALY_MULTIPLIER=2

# Research imports from ChatGPT. Token grants import-only access, never email sending.
RESEARCH_INGEST_SECRET=
# Optional HTTPS destination for the CLI importer; leave empty for direct local DB imports.
RESEARCH_INGEST_URL=
# GitHub research inbox in the application repository. A token is optional for a public repository.
RESEARCH_GITHUB_REPOSITORY=
RESEARCH_GITHUB_BRANCH=codex/marketing-automation
RESEARCH_GITHUB_TOKEN=
# Local-only opt-in; uses existing gh authentication without copying its token. Disabled on Vercel.
RESEARCH_GITHUB_LOCAL_CLI=false

# Enable unauthenticated read only for an intentionally public research repository.
RESEARCH_GITHUB_PUBLIC=false
