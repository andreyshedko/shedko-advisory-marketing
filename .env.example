# PostgreSQL, pooled production connection with TLS; no secret values in this file.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAIL=
# One-time admin:create only, remove after provisioning.
ADMIN_PASSWORD=
CRON_SECRET=
ADS_INGEST_SECRET=
# Porkbun: STARTTLS on port 587. Full corporate mailbox as username.
SMTP_HOST=smtp.porkbun.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional corporate identity/footer, required to enable external outreach.
OUTREACH_FOOTER=
# Optional public web search via Brave Search API, research only.
BRAVE_SEARCH_API_KEY=
# Daily internal budget alert thresholds, per currency, e.g. {"USD":50,"EUR":40}
DAILY_BUDGETS={}
# Compared with previous 7 days, default multiplier 2
SPEND_ANOMALY_MULTIPLIER=2
